---
import "@/styles/global.css";
import ProcessTimeline from "@/components/landing/ProcessTimeline.astro";
import landingData from "@/data/service-landing.json";
import serviceAreasData from "@/data/service-areas.json";

const SITE = "https://www.jdhomeconstruction.org";
const PHONE_DISPLAY = "267-804-4120";
const PHONE_TEL = "+12678044120";
const EMAIL = "JDhomellc@yahoo.com";

const { slug } = Astro.params;
const pages: any[] = landingData as any[];

// 301 old UUID URLs (/services/<uuid>) to the new slug URLs
const byId = pages.find((p) => p.serviceId === slug);
if (byId) {
  return Astro.redirect(`/services/${byId.slug}`, 301);
}

const page = pages.find((p) => p.slug === slug);
if (!page) {
  return Astro.redirect("/services", 302);
}

const canonical = `${SITE}/services/${page.slug}`;

// Geo areas: explicit areasDetail wins; otherwise derive from service-areas.json
const derivedAreas = (serviceAreasData as any[]).filter((a) =>
  a.relatedServices?.includes(page.serviceId)
);
const hasAreasDetail = page.areasDetail && page.areasDetail.length > 0;

const navLinks = [
  { name: "Home", path: "/" },
  { name: "About", path: "/about" },
  { name: "Services", path: "/services" },
  { name: "Areas", path: "/areas" },
  { name: "Projects", path: "/projects" },
  { name: "Blog", path: "/blog" },
  { name: "Contact", path: "/contact" },
];

const otherServices = pages.filter((p) => p.slug !== page.slug);
const galleryFirst = !!(page.gallery && page.gallery.length > 0);

// ---------- Structured data ----------
const businessNode = {
  "@type": "HomeAndConstructionBusiness",
  "@id": `${SITE}/#business`,
  name: "JD Home Construction",
  url: SITE,
  telephone: PHONE_TEL,
  email: EMAIL,
  image: `${SITE}/images/JD-Home-Construction.png`,
  logo: `${SITE}/images/JD-Home-Construction.png`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Philadelphia",
    addressRegion: "PA",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "City", name: "Philadelphia" },
    { "@type": "AdministrativeArea", name: "Lower Merion Township" },
    { "@type": "AdministrativeArea", name: "Montgomery County" },
    { "@type": "AdministrativeArea", name: "Bucks County" },
  ],
  priceRange: "$$",
};

const serviceNode: Record<string, any> = {
  "@type": "Service",
  "@id": `${canonical}/#service`,
  name: page.h1,
  serviceType: page.name,
  description: page.metaDescription,
  url: canonical,
  provider: { "@id": `${SITE}/#business` },
  areaServed: hasAreasDetail
    ? page.areasDetail.map((a: any) => ({ "@type": "Place", name: a.name }))
    : [
        { "@type": "City", name: "Philadelphia" },
        { "@type": "AdministrativeArea", name: "Bucks County" },
      ],
  image: `${SITE}${page.heroImage}`,
};
if (page.plans && page.plans.length > 0) {
  serviceNode.hasOfferCatalog = {
    "@type": "OfferCatalog",
    name: `${page.name} Plans`,
    itemListElement: page.plans.map((plan: any) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: plan.name, description: plan.description },
    })),
  };
}

const faqNode = {
  "@type": "FAQPage",
  "@id": `${canonical}/#faq`,
  mainEntity: page.faqs.map((f: any) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbNode = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE },
    { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services` },
    { "@type": "ListItem", position: 3, name: page.name, item: canonical },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [businessNode, serviceNode, faqNode, breadcrumbNode],
};
---

<html lang="en" class="w-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{page.metaTitle}</title>
    <meta name="description" content={page.metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#1A1A1A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {page.heroBackground && <link rel="preload" as="image" href={page.heroBackground} fetchpriority="high" />}
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JD Home Construction" />
    <meta property="og:title" content={page.metaTitle} />
    <meta property="og:description" content={page.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}${page.heroImage}`} />
    <meta property="og:locale" content="en_US" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.metaTitle} />
    <meta name="twitter:description" content={page.metaDescription} />
    <meta name="twitter:image" content={`${SITE}${page.heroImage}`} />
    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="w-full bg-background text-foreground font-paragraph antialiased">
    {page.snowEffect && (
      <canvas
        id="snowfall"
        class="fixed inset-0 w-full h-full pointer-events-none z-40"
        aria-hidden="true"
      ></canvas>
    )}
    <!-- Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-secondary/95 backdrop-blur-md shadow-lg">
      <div class="max-w-[120rem] mx-auto px-4 sm:px-8">
        <div class="flex items-center justify-between" style="height: calc(4rem + 15px);">
          <a href="/" class="flex items-center flex-shrink-0 min-h-16" aria-label="JD Home Construction home">
            <img
              src="/images/JD-Home-Construction.png"
              width="133"
              height="53"
              class="h-14 sm:h-16 w-auto object-contain"
              alt="JD Home Construction - Licensed and Insured Philadelphia General Contractor"
              loading="eager"
            />
          </a>
          <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
            {navLinks.map((link) => (
              <a href={link.path} class="font-heading text-base text-white/80 hover:text-accent-orange transition-colors">{link.name}</a>
            ))}
          </nav>
          <div class="flex items-center gap-3">
            <a
              href={`tel:${PHONE_TEL}`}
              class="hidden lg:inline-flex font-heading bg-accent-orange hover:bg-accent-orange/90 text-secondary px-6 h-11 rounded-lg items-center justify-center transition-all"
            >Call {PHONE_DISPLAY}</a>
            <a
              href="#quote-form"
              class="hidden lg:inline-flex font-heading bg-white/10 hover:bg-white/20 text-white px-6 h-11 rounded-lg items-center justify-center transition-all"
            >Free Quote</a>
            <button
              id="mobile-menu-btn"
              class="lg:hidden p-2 text-white"
              aria-label="Toggle menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
              <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
        </div>

        <!-- Mobile navigation -->
        <div id="mobile-menu" class="hidden lg:hidden py-6 border-t border-white/10">
          <nav class="flex flex-col gap-4 px-4" aria-label="Mobile navigation">
            {navLinks.map((link) => (
              <a href={link.path} class="font-heading text-lg text-white/80 hover:text-accent-orange transition-colors">{link.name}</a>
            ))}
            <div class="flex flex-col gap-3 mt-4">
              <a href={`tel:${PHONE_TEL}`} class="font-heading bg-accent-orange hover:bg-accent-orange/90 text-secondary h-11 rounded-lg inline-flex items-center justify-center transition-all">📞 Call {PHONE_DISPLAY}</a>
              <a href="#quote-form" class="font-heading bg-white hover:bg-white/90 text-secondary h-11 rounded-lg inline-flex items-center justify-center transition-all">Free Quote</a>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section
        class="relative w-full bg-secondary text-white pt-32 pb-16 lg:pb-24 bg-cover"
        style={page.heroBackground ? `background-image: url('${page.heroBackground}'); background-position: center 65%;` : undefined}
      >
        {page.heroBackground && (
          <div class="absolute inset-0 bg-gradient-to-b from-secondary/90 via-secondary/70 to-secondary/90" aria-hidden="true"></div>
        )}
        <div class="relative max-w-[100rem] mx-auto px-4 sm:px-8">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
            <div>
              <p class="font-heading text-accent-orange text-sm uppercase tracking-widest mb-4">
                {page.eyebrow ?? "JD Home Construction · Philadelphia, PA"}
              </p>
              <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl mb-6">{page.h1}</h1>
              <p class="font-paragraph text-lg sm:text-xl text-white/80 mb-8 max-w-2xl">{page.subhead}</p>
              <ul class="flex flex-wrap gap-3 mb-10">
                {page.badges.map((badge: string) => (
                  <li class="flex items-center gap-2 bg-white/10 rounded-full px-4 py-2 text-sm font-heading">
                    <svg class="w-4 h-4 text-accent-orange flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    {badge}
                  </li>
                ))}
              </ul>
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href={`tel:${PHONE_TEL}`}
                  class="font-heading text-lg bg-accent-orange hover:bg-accent-orange/90 text-secondary px-8 h-14 rounded-lg inline-flex items-center justify-center transition-all"
                >📞 Call {PHONE_DISPLAY}</a>
                <a
                  href="#quote-form"
                  class="font-heading text-lg bg-white hover:bg-white/90 text-secondary px-8 h-14 rounded-lg inline-flex items-center justify-center transition-all"
                >{page.ctaLabel}</a>
              </div>
              {!page.heroBackground && (
                <img
                  src={page.heroImage}
                  alt={page.heroImageAlt}
                  width="1200"
                  height="675"
                  class="w-full h-64 sm:h-80 object-cover rounded-xl mt-10"
                  loading="eager"
                  fetchpriority="high"
                />
              )}
            </div>

            <!-- Lead form -->
            <div id="quote-form" class="bg-white text-foreground rounded-xl shadow-2xl p-6 sm:p-8 lg:sticky lg:top-28 scroll-mt-28">
              <h2 class="font-heading text-2xl text-secondary mb-2">{page.formHeading}</h2>
              <p class="font-paragraph text-sm text-foreground/70 mb-6">{page.formSub}</p>
              <form id="lead-form" class="space-y-4" novalidate>
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <label for="lead-name" class="block font-heading text-sm text-secondary mb-1">Full Name *</label>
                    <input id="lead-name" name="name" type="text" required autocomplete="name" class="w-full h-11 rounded-lg border border-medium-grey px-3 font-paragraph text-base focus:outline-none focus:ring-2 focus:ring-primary" />
                  </div>
                  <div>
                    <label for="lead-phone" class="block font-heading text-sm text-secondary mb-1">Phone *</label>
                    <input id="lead-phone" name="phone" type="tel" required autocomplete="tel" class="w-full h-11 rounded-lg border border-medium-grey px-3 font-paragraph text-base focus:outline-none focus:ring-2 focus:ring-primary" />
                  </div>
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <label for="lead-email" class="block font-heading text-sm text-secondary mb-1">Email *</label>
                    <input id="lead-email" name="email" type="email" required autocomplete="email" class="w-full h-11 rounded-lg border border-medium-grey px-3 font-paragraph text-base focus:outline-none focus:ring-2 focus:ring-primary" />
                  </div>
                  <div>
                    <label for="lead-zip" class="block font-heading text-sm text-secondary mb-1">ZIP Code *</label>
                    <input id="lead-zip" name="zipCode" type="text" required inputmode="numeric" pattern="[0-9]{5}" autocomplete="postal-code" class="w-full h-11 rounded-lg border border-medium-grey px-3 font-paragraph text-base focus:outline-none focus:ring-2 focus:ring-primary" />
                  </div>
                </div>
                <div>
                  <label for="lead-timeline" class="block font-heading text-sm text-secondary mb-1">{page.timelineLabel} *</label>
                  <select id="lead-timeline" name="timeline" required class="w-full h-11 rounded-lg border border-medium-grey px-3 font-paragraph text-base bg-white focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="" disabled selected>Select one…</option>
                    {page.timelineOptions.map((opt: string) => <option value={opt}>{opt}</option>)}
                  </select>
                </div>
                <div>
                  <label for="lead-details" class="block font-heading text-sm text-secondary mb-1">{page.detailsLabel} *</label>
                  <textarea id="lead-details" name="projectDetails" required rows="3" placeholder={page.detailsPlaceholder} class="w-full rounded-lg border border-medium-grey px-3 py-2 font-paragraph text-base focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
                </div>
                <input type="hidden" name="projectType" value={page.projectType} />
                <input type="hidden" name="budgetRange" value={page.budgetDefault} />
                <button type="submit" class="w-full font-heading text-lg bg-primary hover:bg-primary/90 text-primary-foreground h-13 py-3.5 rounded-lg transition-all">
                  {page.ctaLabel}
                </button>
                <p id="form-error" class="hidden text-sm text-primary font-paragraph"></p>
                <p class="text-xs text-foreground/50 font-paragraph text-center">
                  No spam, ever. Prefer to talk? Call <a href={`tel:${PHONE_TEL}`} class="underline">{PHONE_DISPLAY}</a>.
                </p>
              </form>
              <div id="form-success" class="hidden text-center py-8">
                <div class="text-5xl mb-4">✅</div>
                <h3 class="font-heading text-2xl text-secondary mb-2">Request Received!</h3>
                <p class="font-paragraph text-foreground/80">We'll get back to you within one business day. Need us sooner? Call <a href={`tel:${PHONE_TEL}`} class="text-primary font-heading">{PHONE_DISPLAY}</a>.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Photo gallery (real work photos, directly after hero) -->
      {galleryFirst && (
        <section class="w-full py-16 lg:py-20 bg-light-grey">
          <div class="max-w-[100rem] mx-auto px-4 sm:px-8">
            <h2 class="font-heading text-3xl sm:text-4xl text-secondary text-center mb-4">{page.galleryHeading ?? "Our Work"}</h2>
            <p class="font-paragraph text-lg text-foreground/70 text-center mb-12 max-w-2xl mx-auto">These are our actual trucks and crews — not stock photos.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
              {page.gallery.map((photo: any) => (
                <figure class="group">
                  <div class="overflow-hidden rounded-xl">
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      width="800"
                      height="800"
                      class="w-full h-72 sm:h-80 object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                  {photo.caption && (
                    <figcaption class="font-paragraph text-sm text-foreground/70 mt-3 text-center">{photo.caption}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- How it works (directly after gallery when gallery leads) -->
      {galleryFirst && (
        <ProcessTimeline
          heading={page.processHeading ?? "How It Works"}
          blurb={page.processBlurb ?? "One call starts it. One team handles all of it — from first assessment to final walkthrough."}
          steps={page.process}
          image={page.processImage ?? page.heroImage}
          imageAlt={page.processImageAlt ?? page.heroImageAlt}
          ctaLabel={page.ctaLabel}
          phoneTel={PHONE_TEL}
          phoneDisplay={PHONE_DISPLAY}
          closingLine={page.processClosing}
        />
      )}

      <!-- Intro: editorial split layout when stats/images provided, simple otherwise -->
      {page.introStats && page.introImages ? (
        <section class="w-full py-16 lg:py-24 overflow-hidden">
          <div class="max-w-[100rem] mx-auto px-4 sm:px-8">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
              <div>
                <p class="font-heading text-primary text-sm uppercase tracking-widest mb-4">Built Different</p>
                <h2 class="font-heading text-3xl sm:text-5xl text-secondary mb-8">
                  {page.introHeading ?? `${page.name} Done Right in Philadelphia`}
                </h2>
                <p class="font-paragraph text-xl text-foreground leading-relaxed mb-6">{page.intro[0]}</p>
                {page.intro.slice(1).map((paragraph: string) => (
                  <p class="font-paragraph text-lg text-foreground/85 leading-relaxed mb-6">{paragraph}</p>
                ))}
                {page.introCallout && (
                  <div class="bg-secondary text-white rounded-2xl p-6 sm:p-8 mt-8">
                    <p class="font-heading text-accent-orange text-sm uppercase tracking-widest mb-4">{page.introCallout.title}</p>
                    <div class="space-y-4 mb-5">
                      {page.introCallout.rows.map((row: any) => (
                        <div class="flex items-start gap-4">
                          <svg class="w-5 h-5 text-accent-orange flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                          <p class="font-paragraph text-base text-white/90"><span class="font-heading text-white">{row.place}:</span> {row.rule}</p>
                        </div>
                      ))}
                    </div>
                    <p class="font-paragraph text-sm text-white/70">{page.introCallout.text}</p>
                  </div>
                )}
              </div>

              <div class="lg:sticky lg:top-32 self-start">
                <div class="relative mb-16 sm:mb-20">
                  <img
                    src={page.introImages[0].src}
                    alt={page.introImages[0].alt}
                    width="1000"
                    height="750"
                    class="w-full h-80 sm:h-[26rem] object-cover rounded-2xl shadow-xl"
                    loading="lazy"
                  />
                  {page.introImages[1] && (
                    <img
                      src={page.introImages[1].src}
                      alt={page.introImages[1].alt}
                      width="400"
                      height="400"
                      class="hidden sm:block absolute -bottom-12 -left-6 w-44 h-44 object-cover rounded-2xl border-4 border-white shadow-2xl"
                      loading="lazy"
                    />
                  )}
                  <div class="absolute -bottom-8 right-4 sm:right-8 bg-primary text-primary-foreground rounded-xl px-5 py-4 shadow-2xl">
                    <p class="font-heading text-2xl leading-none">{page.introStats[0].value}</p>
                    <p class="font-paragraph text-xs mt-1 max-w-[10rem]">{page.introStats[0].label}</p>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                  {page.introStats.slice(1).map((stat: any) => (
                    <div class="bg-light-grey rounded-xl p-5 border border-medium-grey/30">
                      <p class="font-heading text-3xl text-primary leading-none mb-2">{stat.value}</p>
                      <p class="font-paragraph text-sm text-foreground/75">{stat.label}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>
      ) : (
        <section class="w-full py-16 lg:py-24">
          <div class="max-w-4xl mx-auto px-4 sm:px-8">
            <h2 class="font-heading text-3xl sm:text-4xl text-secondary mb-8">
              {page.introHeading ?? `${page.name} Done Right in Philadelphia`}
            </h2>
            {page.intro.map((paragraph: string) => (
              <p class="font-paragraph text-lg text-foreground/90 mb-6 leading-relaxed">{paragraph}</p>
            ))}
          </div>
        </section>
      )}

      <!-- Offerings -->
      <section class="w-full bg-light-grey py-16 lg:py-24">
        <div class="max-w-[100rem] mx-auto px-4 sm:px-8">
          <h2 class="font-heading text-3xl sm:text-4xl text-secondary text-center mb-12">{page.offeringsHeading}</h2>
          <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
            {page.offerings.map((item: string) => (
              <li class="flex items-start gap-3 bg-white rounded-xl border border-medium-grey/30 p-5">
                <svg class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="font-paragraph text-base text-foreground">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Plans (snow removal) -->
      {page.plans && page.plans.length > 0 && (
        <section class="w-full py-16 lg:py-24">
          <div class="max-w-[100rem] mx-auto px-4 sm:px-8">
            <h2 class="font-heading text-3xl sm:text-4xl text-secondary text-center mb-4">Pick Your Winter Plan</h2>
            <p class="font-paragraph text-lg text-foreground/70 text-center mb-12 max-w-2xl mx-auto">Every plan is a flat rate quoted for your specific driveway — no hourly billing, no surprises.</p>
            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
              {page.plans.map((plan: any, i: number) => (
                <div class={`flex flex-col rounded-xl border p-8 ${i === 0 ? "border-primary border-2 shadow-xl relative" : "border-medium-grey/40"}`}>
                  {plan.badge && (
                    <span class={`font-heading text-xs uppercase tracking-wider rounded-full px-3 py-1 self-start mb-4 ${i === 0 ? "bg-primary text-primary-foreground" : "bg-light-grey text-secondary"}`}>{plan.badge}</span>
                  )}
                  <h3 class="font-heading text-2xl text-secondary mb-3">{plan.name}</h3>
                  <p class="font-paragraph text-foreground/80 mb-6">{plan.description}</p>
                  <ul class="space-y-3 mb-8">
                    {plan.features.map((feature: string) => (
                      <li class="flex items-start gap-2">
                        <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span class="font-paragraph text-sm text-foreground">{feature}</span>
                      </li>
                    ))}
                  </ul>
                  <a href="#quote-form" class={`mt-auto font-heading text-center px-6 py-3 rounded-lg transition-all ${i === 0 ? "bg-primary hover:bg-primary/90 text-primary-foreground" : "bg-secondary hover:bg-secondary/90 text-white"}`}>Get My Flat-Rate Quote</a>
