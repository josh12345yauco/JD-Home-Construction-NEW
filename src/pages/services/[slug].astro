              <li>Email: <a href={`mailto:${EMAIL}`} class="text-secondary-foreground hover:text-primary transition-colors">{EMAIL}</a></li>
              <li>Philadelphia, PA</li>
              <li class="pt-2"><a href="/contact" class="text-secondary-foreground hover:text-primary transition-colors underline">Contact Page</a> · <a href="/areas" class="text-secondary-foreground hover:text-primary transition-colors underline">Service Areas</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-secondary-foreground/20 pt-8">
